# Port d'écoute
PORT=3020
# Secret de session (obligatoire en production, chaîne longue et aléatoire)
SESSION_SECRET=changez-moi
# Compte admin créé au premier démarrage si aucun admin n'existe
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
# URL publique (pour construire les liens d'invitation), modifiable aussi dans l'admin
BASE_URL=http://localhost:3020
# Mettre à 1 derrière un reverse proxy HTTPS (cookie secure + trust proxy)
TRUST_PROXY=0
# Dossier des données (base SQLite + uploads)
# DATA_DIR=/app/data
