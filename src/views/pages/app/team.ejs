<section class="team">
  <a class="icon-btn" href="/" aria-label="Retour" style="margin-bottom:12px">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
  </a>
  <div class="page-head">
    <div class="eyebrow">Équipe</div>
    <h1>Les profils</h1>
    <p class="lead"><%= doneCount %> sur <%= members.length %> ont passé le test.</p>
  </div>
  <div class="team-grid">
    <% members.forEach((m) => { const self = m.id === currentUser.id; %>
    <a class="member<%= m.done ? '' : ' is-pending' %>" href="<%= self ? '/result' : '/team/' + m.id %>">
      <div class="av"><%- renderAvatar(parseAvatar(m.avatar_json), { expression: m.expression }) %></div>
      <div class="name"><%= m.first_name %><% if (self) { %> <span class="you">toi</span><% } %></div>
      <% if (m.done) { %>
        <div class="prof"><i style="--c:<%= m.color %>"></i><%= m.profile.name %></div>
      <% } else { %>
        <div class="prof">Pas encore passé</div>
      <% } %>
    </a>
    <% }); %>
  </div>
</section>
